<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net472;net48;net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- .NET Framework targeting packs -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- System.Drawing.Common for .NET Core tests on Windows -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Imazen.WebP\Imazen.WebP.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="testimage.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="testimage.webp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <PropertyGroup>
    <PostBuildEvent>if not exist $(TargetDir)x86\ mkdir $(TargetDir)x86\
if not exist $(TargetDir)x64\ mkdir $(TargetDir)x64\

if exist $(SolutionDir)bin\Release-Unicode-32bit-x86\ copy $(SolutionDir)bin\Release-Unicode-32bit-x86\MuPDFLib.* $(TargetDir)x86\
if exist $(SolutionDir)bin\Release-Unicode-64bit-x64\ copy $(SolutionDir)bin\Release-Unicode-64bit-x64\MuPDFLib.* $(TargetDir)x64\

if not exist $(SolutionDir)bin\Release-Unicode-32bit-x86\ echo MISSING: $(SolutionDir)bin\Release-Unicode-32bit-x86\MuPDFLib.*
if not exist $(SolutionDir)bin\Release-Unicode-64bit-x64\ echo MISSING: $(SolutionDir)bin\Release-Unicode-64bit-x64\MuPDFLib.*
</PostBuildEvent>
  </PropertyGroup>

</Project>
